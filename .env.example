# Copy this file to `.env` and you are done:
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `npm run tauri:dev` loads `.env` from this folder. Without it the app builds
# and runs, but anything that talks to the AMVerge API reports "not configured
# on this build", and the Discord sign-in button reports the same. That is this
# file missing, not a broken checkout.

# ---------------------------------------------------------------------------
# Community events + Discord sign-in
# ---------------------------------------------------------------------------
# These default to a local backend. To work against the hosted one, ask a
# maintainer for the API URL and the desktop Discord client id — they are not
# published here.
#
# Running the backend locally:
#   1. Clone the AMVerge admin repo
#   2. docker run --name amverge-pg -e POSTGRES_PASSWORD=postgres \
#        -e POSTGRES_DB=amverge -p 5432:5432 -d postgres:16
#   3. npm start   (it creates its own tables on first boot)

# Base URL of the AMVerge API, no trailing slash.
AMVERGE_API_BASE_URL=http://localhost:3001

# Client id of the *desktop* Discord application. Needed only to sign in and
# host events; browsing works without it. If you create your own Discord
# application for local work, register these redirect URIs on it exactly:
#   http://127.0.0.1:53421/callback
#   http://127.0.0.1:53422/callback
#   http://127.0.0.1:53423/callback
AMVERGE_DISCORD_APP_CLIENT_ID=

# ---------------------------------------------------------------------------
# Bug reports
# ---------------------------------------------------------------------------
# Submitting a bug report needs a signing key issued by a maintainer. Every
# other part of the app works without one; only the bug report form refuses.

AMVERGE_BUG_REPORT_API_URL=http://localhost:3001/api/bug-reports
AMVERGE_BUG_REPORT_API_KEY=
AMVERGE_BUG_REPORT_KEY_ID=
AMVERGE_BUG_REPORT_SIGNING_SECRET=

AMVERGE_NOTIFICATIONS_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------------------
# Absolute path to an AMVerge-CLI checkout, if you are working on the CLI
# alongside the app. Leave blank to use the bundled sidecar.
AMVERGE_CLI_DIR=
