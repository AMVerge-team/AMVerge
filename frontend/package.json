{
  "name": "amverge",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:sidecar": "node ./scripts/build-sidecar.mjs",
    "fetch:uv": "node ./scripts/fetch-uv.mjs",
    "build:all": "npm run build:sidecar && npm run fetch:uv && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "stub:sidecar": "node ./scripts/stub-sidecar.mjs",
    "tauri:dev": "npm run fetch:uv && npm run stub:sidecar && dotenv -e ../.env -- tauri dev",
    "check:i18n": "node ./scripts/check-i18n.mjs",
    "tauri:build": "node ./scripts/stub-sidecar.mjs --check && dotenv -e ../.env.production -- tauri build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@tauri-apps/api": "~2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "i18next": "^26.7.2",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-icons": "^5.7.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "dotenv-cli": "^11.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
