{
  "app": {
    "windows": [
      {
        "title": "AMVerge",
        "minWidth": 920,
        "minHeight": 540,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000",
        "trafficLightPosition": {
          "x": 16,
          "y": 23
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": [
      "bin/amverge-aarch64-apple-darwin/amverge",
      "bin/amverge-aarch64-apple-darwin/_internal/**/*",
      "bin/amverge-aarch64-apple-darwin/_internal/ffmpeg",
      "bin/amverge-aarch64-apple-darwin/_internal/ffprobe",
      "bin/uv/aarch64-apple-darwin/uv"
    ]
  }
}
