{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMVerge Setup",
  "version": "2.0.2",
  "identifier": "app.amverge.setup",
  "mainBinaryName": "AMVerge-Setup",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMVerge Setup",
        "width": 840,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "backgroundColor": "#0d0d0f"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
